<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Supervisor Profile Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_luxury_executive_header"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_luxury_avatar_ring">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_supervisor_avatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:background="#E0F2FE"
                        android:padding="8dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.Corner.Full"
                        app:srcCompat="@drawable/ic_baseline_person_24"
                        app:tint="#0284C7" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_supervisor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:text="Supervisor Name"
                    android:textColor="#03045E"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_supervisor_emp_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_top_header_pill"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="3dp"
                    android:text="Supervisor ID: #--"
                    android:textColor="#0284C7"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_supervisor_site"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Verified Site: Loading..."
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_supervisor_change_site"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#0284C7"
                        android:fontFamily="sans-serif-bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="CHANGE SITE"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:cornerRadius="17dp"
                        app:elevation="3dp"
                        app:icon="@drawable/ic_baseline_move_site_24"
                        app:iconPadding="4dp"
                        app:iconSize="14dp"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Today's Self Punch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:text="TODAY'S SELF ATTENDANCE"
                        android:textColor="#0F172A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_self_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_top_header_pill"
                        android:fontFamily="sans-serif-black"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="NOT PUNCHED"
                        android:textColor="#0284C7"
                        android:textSize="10sp" />
                </RelativeLayout>

                <!-- Time IN & Time OUT Boxes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- TIME IN Box -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_luxury_metric_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.04"
                            android:text="TIME IN"
                            android:textColor="#0284C7"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_self_time_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            android:text="--:--"
                            android:textColor="#0F172A"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- TIME OUT Box -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_luxury_metric_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.04"
                            android:text="TIME OUT"
                            android:textColor="#D97706"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_self_time_out"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            android:text="--:--"
                            android:textColor="#0F172A"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_self_project"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Project: --"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- HIGHLIGHTED SUPERVISOR ACTIONS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#F0F9FF"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#0284C7"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ "
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.06"
                            android:text="SUPERVISOR ACTIONS"
                            android:textColor="#03045E"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_top_header_pill"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="LIVE CONTROL"
                        android:textColor="#0284C7"
                        android:textSize="10sp" />
                </RelativeLayout>

                <!-- Self TIME IN Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_self_time_in"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#0284C7"
                    android:fontFamily="sans-serif-bold"
                    android:text="SELF TIME IN"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_baseline_camera_alt_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="#FFFFFF" />

                <!-- Self TIME OUT Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_self_time_out"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#059669"
                    android:fontFamily="sans-serif-bold"
                    android:text="SELF TIME OUT"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_baseline_check_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="#FFFFFF" />

                <!-- Self MOVE SITE Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_self_move_site"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#4F46E5"
                    android:fontFamily="sans-serif-bold"
                    android:text="MOVE TO ANOTHER SITE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_baseline_move_site_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SUPERVISOR PAST ATTENDANCE HISTORY MANAGE SECTION -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Section Header Title -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.04"
                            android:text="HISTORY"
                            android:textColor="#0F172A"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_supervisor_history_refresh"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif-bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="REFRESH"
                        android:textColor="#0284C7"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_baseline_swap_horiz_24"
                        app:iconPadding="4dp"
                        app:iconSize="14dp"
                        app:iconTint="#0284C7" />
                </RelativeLayout>

                <!-- Date Filter Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_luxury_glass_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <Spinner
                        android:id="@+id/spinner_supervisor_history_day"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_luxury_metric_card"
                        android:spinnerMode="dropdown" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="1dp" />

                    <Spinner
                        android:id="@+id/spinner_supervisor_history_month"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/bg_luxury_metric_card"
                        android:spinnerMode="dropdown" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="1dp" />

                    <Spinner
                        android:id="@+id/spinner_supervisor_history_year"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.1"
                        android:background="@drawable/bg_luxury_metric_card"
                        android:spinnerMode="dropdown" />
                </LinearLayout>


                <!-- History Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_supervisor_history"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginVertical="12dp"
                    android:visibility="gone" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/ll_supervisor_history_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:srcCompat="@drawable/ic_baseline_calendar_today_24"
                        app:tint="#94A3B8" />

                    <TextView
                        android:id="@+id/tv_supervisor_history_empty_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="No past attendance history found for this date."
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Past Attendance History List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_supervisor_past_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progress_supervisor_self"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
