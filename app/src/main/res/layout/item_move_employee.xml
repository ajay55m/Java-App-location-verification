<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_move_emp_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_move_avatar">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/tv_emp_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.Corner.Full"
            app:srcCompat="@drawable/ic_baseline_person_24" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_emp_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.Corner.Full"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_emp_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Employee"
            android:textColor="#03045E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_emp_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_move_badge_off"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="READY"
            android:textAllCaps="true"
            android:textColor="#0077B6"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tv_emp_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Primary —"
            android:textColor="#0077B6"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_emp_action"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="84dp"
        android:text="MOVE"
        android:textAllCaps="true"
        android:textSize="11sp"
        android:textStyle="bold"
        app:backgroundTint="#03045E"
        app:cornerRadius="12dp" />
</LinearLayout>
