<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_move_emp_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar circle/rectangle -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_move_avatar">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/tv_emp_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:cornerRadius="8dp"
            app:srcCompat="@drawable/ic_baseline_person_24" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_emp_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:cornerRadius="8dp"
            app:strokeColor="#90E0EF"
            app:strokeWidth="1dp" />
    </FrameLayout>

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_emp_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Employee Name"
            android:textColor="#03045E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_emp_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_move_badge_off"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="NOT CLOCKED IN"
            android:textAllCaps="true"
            android:textColor="#0077B6"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tv_emp_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Status: Not Clocked In"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Right Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_time_in"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:minWidth="68dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="IN"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="#03045E"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_time_out"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="68dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="OUT"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="#0077B6"
            app:cornerRadius="18dp" />
    </LinearLayout>

</LinearLayout>
