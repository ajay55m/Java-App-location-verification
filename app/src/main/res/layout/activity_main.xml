<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:scrollbars="vertical"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <!-- No Internet Bar Section -->
        <LinearLayout
            android:id="@+id/noInternetBar"
            android:theme="@style/AppTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000" 
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="10dp"
            android:translationZ="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ic_warning_red"
                app:tint="#FFFFFF"
                android:background="@android:color/transparent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="No internet connection"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:backgroundTint="#FFFFFF"
                android:text="TRY AGAIN"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                app:cornerRadius="16dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
        </LinearLayout>

        <!-- Top Background Construction Graphic (Lower starting position) -->
        <ImageView
            android:id="@+id/backgroundImg"
            android:layout_width="0dp"
            android:layout_height="320dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:scaleType="centerCrop"
            android:src="@drawable/pexels_user_30223853" />

        <!-- Overlay gradient for subtle image depth -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@+id/backgroundImg"
            app:layout_constraintBottom_toBottomOf="@+id/backgroundImg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="#15000000" />

        <!-- White Background Filler below Image to guarantee 100% white screen -->
        <View
            android:id="@+id/white_bottom_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@+id/backgroundImg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Space
            android:id="@+id/overlap_space"
            android:layout_width="0dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="@+id/backgroundImg"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Pure White Rounded Login Card (positioned lower, scrolls smoothly with soft keyboard) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/overlap_space"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="16dp"
            app:strokeWidth="0dp"
            app:cardCornerRadius="28dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Corner.Top">

            <LinearLayout
                android:id="@+id/loginView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="28dp"
                android:paddingBottom="36dp"
                android:background="#FFFFFF">

                <!-- Splash Brand Logo (logo_4s_full) -->
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_4s_full" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="Subcontractor Login"
                    android:textColor="#03045E"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02" />

                <!-- Input Fields Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/username"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edit_text_minimalist"
                        android:drawableStart="@drawable/ic_baseline_email_24"
                        android:drawablePadding="14dp"
                        android:drawableTint="#0077B6"
                        android:hint="Email or Username"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="#03045E"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/edit_text_minimalist"
                        android:drawableStart="@drawable/ic_baseline_lock_24"
                        android:drawablePadding="14dp"
                        android:drawableTint="#0077B6"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="#03045E"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Login Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginbtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="24dp"
                    app:backgroundTint="#03045E"
                    android:text="Sign In"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    app:cornerRadius="16dp"
                    app:elevation="4dp" />

                <!-- Bottom Tagline Footer -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="4S-CONTRACTING • SUBCONTRACTOR PORTAL"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>