<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Top-Left Inner Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/soft_shadow_dark" />
        </shape>
    </item>
    <!-- Light Bottom-Right Inner Highlight -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/soft_shadow_light" />
        </shape>
    </item>
    <!-- Main Content Background -->
    <item android:top="2dp" android:left="2dp" android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/soft_azure" />
        </shape>
    </item>
</layer-list>
